        <!--View Controller-->
        <scene sceneID="hyz-SJ-w2K">
            <objects>
                <viewController id="lyR-jN-oKf" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="YFv-Xv-4CU">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="842"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Research Papers" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Fiy-8Y-C3c">
                                <rect key="frame" x="0.0" y="20" width="393" height="36"/>
                                <fontDescription key="fontDescription" type="system" pointSize="30"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Red Light and the Sleep Quality and Endurance Performance of Chinese Female Basketball Players" lineBreakMode="tailTruncation" numberOfLines="4" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="UZI-7Q-7SC">
                                <rect key="frame" x="16" y="88" width="361" height="61"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" lineBreakMode="tailTruncation" numberOfLines="37" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="0Ju-3K-Q0I">
                                <rect key="frame" x="16" y="159" width="361" height="200.66666666666663"/>
                                <string key="text">This study explores the impact of red light therapy (620-660 nm) on sleep quality and endurance performance in 20 Chinese female basketball players. Over 14 days, participants receiving nightly red light showed significant improvements in sleep quality and serum melatonin levels. Although the red light group experienced a greater percentage increase in endurance performance, the change wasn't statistically significant. The findings suggest red light therapy as a nonpharmacologic approach to enhance sleep and recovery in athletes, highlighting its potential role in sports medicine.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <color key="textColor" systemColor="systemGrayColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Pulsed Led’s Light at 650 nm Promote and at 470 nm Suppress Melatonin’s Secretion" lineBreakMode="tailTruncation" numberOfLines="3" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Sdd-26-0Tr">
                                <rect key="frame" x="16" y="414.66666666666669" width="361" height="40.666666666666686"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" lineBreakMode="tailTruncation" numberOfLines="21" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FxT-LZ-M0v">
                                <rect key="frame" x="16" y="465.33333333333331" width="361" height="167.33333333333331"/>
                                <string key="text">This research examines how melatonin levels are affected by different light stimuli. It found that red LED light (650 nm) significantly increases melatonin levels, particularly at night, while blue LED light (470 nm) does not have a notable impact. The study highlights the potential of red light for therapeutic applications in sleep disorders and neurodegenerative diseases due to its positive effect on mitochondrial activity. Overall, red light may improve sleep quality and support better health outcomes.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <color key="textColor" systemColor="systemGrayColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="i8i-g9-TWa"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="Fiy-8Y-C3c" firstAttribute="top" secondItem="i8i-g9-TWa" secondAttribute="top" constant="20" id="4hs-G7-tj9"/>
                            <constraint firstItem="i8i-g9-TWa" firstAttribute="trailing" secondItem="UZI-7Q-7SC" secondAttribute="trailing" constant="16" id="5tQ-Tj-VXh"/>
                            <constraint firstItem="FxT-LZ-M0v" firstAttribute="top" secondItem="Sdd-26-0Tr" secondAttribute="bottom" constant="10" id="8Eb-Rs-KV1"/>
                            <constraint firstItem="UZI-7Q-7SC" firstAttribute="leading" secondItem="i8i-g9-TWa" secondAttribute="leading" constant="16" id="AL2-na-9Y0"/>
                            <constraint firstAttribute="trailing" secondItem="0Ju-3K-Q0I" secondAttribute="trailing" constant="16" id="Bwe-t6-rWI"/>
                            <constraint firstItem="Sdd-26-0Tr" firstAttribute="leading" secondItem="i8i-g9-TWa" secondAttribute="leading" constant="16" id="FBb-s6-WY8"/>
                            <constraint firstItem="0Ju-3K-Q0I" firstAttribute="top" secondItem="UZI-7Q-7SC" secondAttribute="bottom" constant="10" id="Fl9-uF-Uvc"/>
